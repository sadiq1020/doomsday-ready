# Server Port & Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Client Port & Public API
CLIENT_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doomsday_ready

# Database Connection URLs:
# - Local development (connecting to Docker Compose PostgreSQL on mapped port 5433):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/doomsday_ready?schema=public

# - Docker Compose internal service (server container connecting to db container):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/doomsday_ready?schema=public
